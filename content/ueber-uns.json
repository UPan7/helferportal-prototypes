    {
      "fields": [
        {
          "id": "hero-title",
          "level": "basic",
          "type": "text",
          "value": "Gemeinsam für eine bessere Versorgung"
        },
        {
          "id": "hero-subtitle",
          "level": "basic",
          "type": "text",
          "value": "Seit 2015 entwickeln wir digitale Lösungen, die Unterstützung, Engagement und Versorgung miteinander verbinden, einfach, sicher und nah."
        }
      ],
      "id": "b1",
      "type": "hero"
    },
    {
      "fields": [
        {
          "id": "section-overline",
          "level": "basic",
          "type": "text",
          "value": "Unsere Mission"
        },
        {
          "id": "section-title",
          "level": "basic",
          "type": "text",
          "value": "Wir verbinden Menschen, damit Hilfe immer einen Weg findet."
        },
        {
          "id": "section-text",
          "level": "basic",
          "type": "textarea",
          "value": "Gemeinsam mit Bürgerinnen und Bürgern, der Sozialwirtschaft, Dienstleistern und Kommunen sorgen wir dafür, dass Menschen mit Unterstützungsbedarf und pflegende Angehörige schnell passende Unterstützung finden."
        },
        {
          "id": "section-values",
          "level": "basic",
          "type": "textarea",
          "value": "Vernetzt\nBedarfsgerecht\nEntlastend\nDigital koordiniert"
        },
        {
          "id": "item-1-text",
          "level": "basic",
          "type": "textarea",
          "value": "Das Helferportal ist das digitale Herz der Sorgegemeinschaft."
        },
        {
          "id": "item-1-title",
          "level": "basic",
          "type": "text",
          "value": "— Der C2C-Ansatz des Helferportals"
        }
      ],
      "id": "b2",
      "type": "mission-section"
    },
    {
      "fields": [
        {
          "id": "section-title",
          "level": "basic",
          "type": "text",
          "value": "Unsere Arbeit basiert auf klaren Werten"
        },
        {
          "id": "item-1-title",
          "level": "basic",
          "type": "text",
          "value": "Gemeinschaft"
        },
        {
          "id": "item-1-text",
          "level": "basic",
          "type": "text",
          "value": "Gemeinsam tragen, was alleine zu schwer ist"
        },
        {
          "id": "item-2-title",
          "level": "basic",
          "type": "text",
          "value": "Offenheit"
        },
        {
          "id": "item-2-text",
          "level": "basic",
          "type": "text",
          "value": "Hilfe für jeden, ohne Hürden"
        },
        {
          "id": "item-3-title",
          "level": "basic",
          "type": "text",
          "value": "Fürsorge"
        },
        {
          "id": "item-3-text",
          "level": "basic",
          "type": "text",
          "value": "Wir kümmern uns – füreinander"
        }
      ],
      "id": "b2a",
      "type": "values-section"
    },
    {
      "fields": [
        {
          "id": "section-title",
          "level": "basic",
          "type": "text",
          "value": "Unsere Geschichte"
        },
        {
          "id": "section-text",
          "level": "basic",
          "type": "text",
          "value": "Von der Idee zur Plattform"
        },
        {
          "id": "item-1-year",
          "level": "basic",
          "type": "text",
          "value": "2015"
        },
        {
          "id": "item-1-title",
          "level": "basic",
          "type": "text",
          "value": "Gründung"
        },
        {
          "id": "item-1-text",
          "level": "basic",
          "type": "textarea",
          "value": "Entwicklung eines Versorgungskonzepts für Seniorinnen und Senioren.\nGründung des Vereins deinNachbar e.V. als Praxislabor für neue Versorgungs- und Engagementkonzepte."
        },
        {
          "id": "item-2-year",
          "level": "basic",
          "type": "text",
          "value": "2017"
        },
        {
          "id": "item-2-title",
          "level": "basic",
          "type": "text",
          "value": "Digitalisierung Nachbarschaftshilfe"
        },
        {
          "id": "item-2-text",
          "level": "basic",
          "type": "textarea",
          "value": "Einführung digitaler Prozesse und mobiler Apps zur Koordination von Einsätzen."
        },
        {
          "id": "item-3-year",
          "level": "basic",
          "type": "text",
          "value": "2024"
        },
        {
          "id": "item-3-title",
          "level": "basic",
          "type": "text",
          "value": "Zugang für Hilfesuchende & Katastrophenschutzmodul"
        },
        {
          "id": "item-3-text",
          "level": "basic",
          "type": "textarea",
          "value": "Webzugang für Hilfesuchende und Integration eines Moduls zur Koordination großer Einsätze im Katastrophenschutz."
        },
        {
          "id": "item-4-year",
          "level": "basic",
          "type": "text",
          "value": "2025"
        },
        {
          "id": "item-4-title",
          "level": "basic",
          "type": "text",
          "value": "Öffnung der Plattform"
        },
        {
          "id": "item-4-text",
          "level": "basic",
          "type": "textarea",
          "value": "Integration von Gesundheits- und Sozialdienstleistern sowie Einführung der Kümmererfunktion für Beratungsstellen."
        },
        {
          "id": "item-5-year",
          "level": "basic",
          "type": "text",
          "value": "2026"
        },
        {
          "id": "item-5-title",
          "level": "basic",
          "type": "text",
          "value": "Sektorenübergreifende und integrative Versorgungsstrukturen digital steuern"
        },
        {
          "id": "item-5-text",
          "level": "basic",
          "type": "textarea",
          "value": "Aufbau sektorenübergreifender und integrativer Versorgungsstrukturen mit digitaler Bedarfserfassung, Vermittlung und Koordination.\nEinführung geschützter Kommunikation per Chat und Video.\nÜbertragung des Versorgungsmodells in andere Städte und Landkreise."
        }
      ],
      "id": "b3",
      "type": "timeline-section"
    },
    {
      "fields": [
        {
          "id": "section-title",
          "level": "basic",
