    {
      "id": "b3",
      "type": "faq-section",
      "fields": [
        {
          "id": "faq-title",
          "type": "text",
          "level": "basic",
          "value": "Häufige Fragen"
        },
        {
          "id": "faq-subtitle",
          "type": "text",
          "level": "basic",
          "value": "Schnelle Antworten"
        },
        {
          "id": "faq-1-question",
          "type": "text",
          "level": "basic",
          "value": "Ist die Nutzung des Helferportals wirklich kostenlos?"
        },
        {
          "id": "faq-1-answer",
          "type": "textarea",
          "level": "basic",
          "value": "Ja, die Nutzung des Helferportals ist für Hilfesuchende und Engagierte vollständig kostenfrei. Es gibt die Möglichkeit, einen freiwilligen Solidaritätsbeitrag zu leisten, der jedoch keinen Einfluss auf die Leistungen hat."
        },
        {
          "id": "faq-2-question",
          "type": "text",
          "level": "basic",
          "value": "Wie schnell erhalte ich eine Antwort auf meine Anfrage?"
        },
        {
          "id": "faq-2-answer",
          "type": "textarea",
          "level": "basic",
          "value": "Wir bemühen uns, alle Anfragen innerhalb von 24 Stunden zu beantworten. Bei dringenden Anliegen können Sie uns auch telefonisch erreichen."
        },
        {
          "id": "faq-3-question",
          "type": "text",
          "level": "basic",
          "value": "Wie kann meine Kommune das Helferportal nutzen?"
        },
        {
          "id": "faq-3-answer",
          "type": "textarea",
          "level": "basic",
          "value": "Kommunen und Landkreise können das Helferportal als digitales Koordinationsportal für ihre Versorgungsstrukturen einsetzen. Kontaktieren Sie uns für eine unverbindliche Demo und individuelle Beratung."
        },
        {
          "id": "faq-4-question",
          "type": "text",
          "level": "basic",
          "value": "Sind meine Daten sicher?"
        },
        {
          "id": "faq-4-answer",
          "type": "textarea",
          "level": "basic",
          "value": "Ja, der Schutz Ihrer Daten hat für uns höchste Priorität. Wir sind DSGVO-konform, hosten alle Daten in Deutschland und verwenden modernste Verschlüsselungstechnologien."
        }
      ]
    }
  ]
