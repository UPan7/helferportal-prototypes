        },
        {
          "id": "cards-title",
          "type": "text",
          "level": "basic",
          "value": "Gut vorbereitet für Dein Engagement"
        },
        {
          "id": "cards-text",
          "type": "textarea",
          "level": "basic",
          "value": "Der Verein deinNachbar e.V. bietet Dir umfassende Qualifizierungsmöglichkeiten — damit Du sicher und kompetent helfen kannst."
        },
        {
          "id": "card-1-title",
          "type": "text",
          "level": "basic",
          "value": "Live via Zoom"
        },
        {
          "id": "card-1-text",
          "type": "text",
          "level": "basic",
          "value": "Präsenzunterricht über Zoom mit erfahrenen Dozenten. Interaktiv, praxisnah und in kleinen Gruppen."
        },
        {
          "id": "card-2-title",
          "type": "text",
          "level": "basic",
          "value": "Online-Akademie"
        },
        {
          "id": "card-2-text",
          "type": "text",
          "level": "basic",
          "value": "Flexibles Einzelstudium über unsere digitale Lernplattform. Lerne in Deinem Tempo — wann und wo es Dir passt."
        },
        {
          "id": "card-3-title",
          "type": "text",
          "level": "basic",
          "value": "Fortbildungsangebote"
        },
        {
          "id": "card-3-text",
          "type": "text",
          "level": "basic",
          "value": "Regelmäßige Weiterbildungen zu Alltagsbegleitung, Kommunikation und Pflege-Grundlagen."
        },
        {
