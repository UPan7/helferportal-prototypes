        {
          "id": "hero-subtitle",
          "level": "basic",
          "type": "textarea",
          "value": "Ob im Alltag, bei Freizeitaktivitäten oder bei Pflege und Versorgung, hier finden Sie Unterstützung in Ihrer Nähe. Sicher und unkompliziert."
        }
      ],
